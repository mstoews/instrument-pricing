# Copy to .env (gitignored), then `set -a; . ./.env; set +a` before make targets.
# Neon: Console → project → Connect. Use the pooled host (contains "-pooler") for the API
# and the direct host for migrations. Neon requires TLS; keep sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/pricing?sslmode=require
MIGRATE_DATABASE_URL=postgres://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/pricing?sslmode=require
# Bind address; PORT (set by Cloud Run and similar platforms) is used when HTTP_ADDR is unset.
HTTP_ADDR=127.0.0.1:8080
# Authentication (defaults shown). Sign-up creates user-role accounts; admins come from cmd/useradmin.
AUTH_ALLOW_SIGNUP=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Ingestion clients (Python RestSink / pricing-ingest): an ingest-scoped API key.
PRICING_API_KEY=
# Massive (formerly Polygon.io) market data for `make ingest-massive`.
MASSIVE_API_KEY=
# MASSIVE_CALLS_PER_MINUTE=5        # free tier; raise on paid plans
# MASSIVE_BASE_URL=https://api.massive.com
